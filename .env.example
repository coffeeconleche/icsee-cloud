# Account secrets belong only in an ignored .env file.
ICSEE_USERNAME=your-account@example.com
ICSEE_PASSWORD=replace-me
ICSEE_DEVICE_NAME=Your camera name
# Alternatively, select a device by its serial. Keep the real serial private.
ICSEE_DEVICE_ID=
# Optional override for an account in another country; normally leave empty.
# Otherwise reuse the last successful account country, or discover the app default.
ICSEE_COUNTRY=
# Optional legacy fixed backend, used when country is empty; omit for automatic:
# ICSEE_REGION=global
ICSEE_CLIENT_IDENTITY_FILE=client.local.json
ICSEE_HELPER_APK=runtime/android-helper/local-icsee-probe.apk
ICSEE_AVD=YourArmCompatibleAvd
ICSEE_RECORDING_TIMEZONE=UTC
# Optional executable locations; Android SDK and PATH defaults are supported.
# ICSEE_ADB=
# ICSEE_FFMPEG=
# ICSEE_EMULATOR=
