include README.md LICENSE SECURITY.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md .env.example
recursive-include docs *.md
recursive-include examples *.json
recursive-include scripts *.ps1
recursive-include tools *.py
recursive-include android *.java *.xml
recursive-include tests *.py
prune .research
prune runtime
prune recordings
prune logs
prune apk
global-exclude *.pyc __pycache__ *.local.json *.apk *.apks *.so *.dll *.keystore
